# Copy this file to .env and fill in your real credentials.
# .env is gitignored and will never be uploaded.
TRADIER_TOKEN = "your_tradier_token_here"

# Storage. Leave unset locally to use the SQLite file data/options_engine.db.
# On Railway the container is wiped on every deploy, so either attach a
# Volume at /data and set:
# OPTIONS_DB_URL = "sqlite:////data/options_engine.db"
# or add a Postgres database and reference its DATABASE_URL:
# DATABASE_URL = "postgresql://user:pass@host:5432/railway"
